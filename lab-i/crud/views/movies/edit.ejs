<%- include('../_head') %>
<% title = `Edit Movie ${movie.title} (${movie.id})`; bodyClass = 'edit'; %>

<h1><%= title %></h1>

<form action="/movie/<%= movie.id %>/edit" method="POST" class="edit-form">
  <%- include('_form', { movie }) %>
</form>

<ul class="action-list">
  <li><a href="/movie">Back to list</a></li>
  <li>
    <form action="/movie/<%= movie.id %>/delete" method="POST">
      <input type="submit" value="Delete" onclick="return confirm('Are you sure?')">
    </form>
  </li>
</ul>