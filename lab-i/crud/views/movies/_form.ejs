<div class="form-group">
  <label for="title">Title</label>
  <input
    type="text"
    id="title"
    name="title"
    value="<%= movie.title || '' %>"
  >
</div>

<div class="form-group">
  <label for="director">Director</label>
  <input
    type="text"
    id="director"
    name="director"
    value="<%= movie.director || '' %>"
  >
</div>

<div class="form-group">
  <input type="submit" value="Submit">
</div>